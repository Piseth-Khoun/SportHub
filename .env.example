# Base URL of the Sport API (no trailing slash needed). Server-side only.
API_BASE_URL=https://sport-api.eunglyzhia.com/api/v1

# Public URL of this site (used for metadata / Open Graph links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seconds server-rendered data is cached before it is revalidated.
REVALIDATE_SECONDS=60

# Hosts whose images go through next/image optimization (comma separated).
# Images from other hosts still render, just without optimization.
IMAGE_HOSTS=sport-hub.eunglyzhia.social,*.eunglyzhia.social,*.eunglyzhia.com
